{
  "name": "polidium",
  "productName": "Polidium",
  "version": "2.1.1",
  "description": "Polid Movie Screen",
  "main": "./dist-electron/index.js",
  "scripts": {
    "test": "pnpm run lint",
    "prepare": "rm -rf node_modules/electron/dist && node node_modules/electron/install.js",
    "dev": "vite",
    "build:app": "pnpm prepare && vue-tsc && vite build",
    "build": "pnpm run build:app && electron-builder --config electron-builder.config.cjs",
    "build:icon": "electron-icon-builder --input=./img/icon.png --output=./public",
    "lint": "tsc --noEmit && vue-tsc --noEmit",
    "release": "pnpm run build:app && electron-builder --publish always --config electron-builder.config.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekobato/Polidium.git"
  },
  "keywords": [],
  "author": "nekobato",
  "bugs": {
    "url": "https://github.com/nekobato/Polidium/issues"
  },
  "homepage": "https://github.com/nekobato/Polidium",
  "devDependencies": {
    "@types/node": "26.6.2",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-debug": "5.0.0",
    "electron-icon-builder": "2.0.1",
    "pinia": "4.0.3",
    "sass-embedded": "1.104.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-electron": "1.1.2",
    "vite-plugin-electron-renderer": "1.0.0",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@iconify/vue": "5.0.2",
    "@sentry/electron": "7.19.0",
    "@vueuse/core": "15.0.0",
    "electron-updater": "6.8.9",
    "element-plus": "2.14.6",
    "vue-router": "5.3.1",
    "xss": "1.0.15"
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "phantomjs-prebuilt"
    ]
  }
}
